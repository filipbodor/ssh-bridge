# Save outside the repository and replace every REPLACE_* value.
Host ssh-bridge-relay
    HostName REPLACE_RELAY_HOST
    Port REPLACE_RELAY_PORT
    User client
    IdentityFile ~/.ssh/ssh_bridge_relay_client
    IdentitiesOnly yes
    ForwardAgent no
    HostKeyAlias ssh-bridge-relay
    UserKnownHostsFile ~/.ssh/ssh_bridge_known_hosts
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ServerAliveCountMax 3

Host ssh-bridge-workstation
    HostName 127.0.0.1
    Port 22022
    User Student
    ProxyJump ssh-bridge-relay
    IdentityFile ~/.ssh/REPLACE_LAPTOP_LOGIN_KEY
    IdentitiesOnly yes
    ForwardAgent no
    HostKeyAlias ssh-bridge-workstation
    UserKnownHostsFile ~/.ssh/ssh_bridge_known_hosts
    StrictHostKeyChecking yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
